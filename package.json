{
  "name": "sheetal",
  "private": true,
  "license": "UNLICENSED",
  "author": "DhamiPlus Pvt. Ltd.",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "platform",
    "apps/*",
    "shared",
    "website/frontend",
    "admin/frontend",
    "business/frontend",
    "backend-core",
    "website/backend",
    "business/backend",
    "admin/backend",
    "mail-server"
  ],
  "scripts": {
    "dev": "concurrently -k -n website,admin,business -c cyan,magenta,green \"npm:dev:website\" \"npm:dev:admin\" \"npm:dev:business\"",
    "dev:website": "npm run dev -w @sheetal/website",
    "dev:admin": "npm run dev -w @sheetal/admin",
    "dev:business": "npm run dev -w @sheetal/business",
    "build": "npm run sitemap && npm run build -w @sheetal/website && npm run build -w @sheetal/admin && npm run build -w @sheetal/business && node scripts/assemble.mjs",
    "preview": "npx vite preview --outDir dist --port 4173",
    "lint": "eslint .",
    "test": "vitest run && npm run test -w @sheetal/backend-core -w @sheetal/website-api -w @sheetal/business-api -w @sheetal/admin-api -w @sheetal/mail-server -w @sheetal/platform -w @sheetal/app-expenses -w @sheetal/app-reviews -w @sheetal/app-rentals",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @sheetal/backend-core -w @sheetal/website-api -w @sheetal/business-api -w @sheetal/admin-api -w @sheetal/mail-server -w @sheetal/platform -w @sheetal/app-expenses -w @sheetal/app-reviews -w @sheetal/app-rentals",
    "gen:permissions": "node scripts/gen-permissions.mjs",
    "check:manifests": "node scripts/check-manifests.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:schema": "node scripts/check-schema-ownership.mjs",
    "check": "node scripts/help.mjs --check && npm run gen:permissions -- --check && npm run check:manifests && npm run check:boundaries && npm run check:schema && npm run lint && npm run typecheck && npm run test",
    "help": "node scripts/help.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check:comments": "node scripts/comments-only.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "db:local": "npm run db:local -w @sheetal/backend-core",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "dev:api": "concurrently -k -n website-api,business-api,admin-api -c cyan,green,magenta \"npm:dev:api:website\" \"npm:dev:api:business\" \"npm:dev:api:admin\"",
    "dev:api:website": "npm run dev -w @sheetal/website-api",
    "dev:api:business": "npm run dev -w @sheetal/business-api",
    "dev:api:admin": "npm run dev -w @sheetal/admin-api",
    "db:migrate": "npm run db:migrate -w @sheetal/backend-core",
    "db:seed": "npm run db:seed -w @sheetal/backend-core",
    "dev:mail": "npm run dev -w @sheetal/mail-server",
    "photos:resize": "npm run photos:resize -w @sheetal/backend-core --",
    "start": "concurrently -n db,api,web,mail -c gray,cyan,green,magenta \"npm:db:local\" \"npm:dev:api\" \"npm:dev\" \"npm:dev:mail\"",
    "listings:tidy": "npm run listings:tidy -w @sheetal/backend-core --",
    "payouts:sample": "npm run payouts:sample -w @sheetal/backend-core --",
    "reviews:sample": "npm run reviews:sample -w @sheetal/backend-core --",
    "integrations:migrate": "npm run integrations:migrate -w @sheetal/backend-core --",
    "expenses:roles": "npm run expenses:roles -w @sheetal/backend-core --",
    "rentals:roles": "npm run rentals:roles -w @sheetal/backend-core --",
    "agreements:roles": "npm run agreements:roles -w @sheetal/backend-core --",
    "people:roles": "npm run people:roles -w @sheetal/backend-core --",
    "promote:gift": "npm run promote:gift -w @sheetal/backend-core --",
    "listings:codes": "npm run listings:codes -w @sheetal/backend-core --",
    "accounts:test": "npm run accounts:test -w @sheetal/backend-core --",
    "qc": "eslint admin business website shared && tsc -p tsconfig.json",
    "dc": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.5"
  }
}
