{
  "name": "sheetal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "website/frontend",
    "admin/frontend",
    "business/frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n website,admin,business -c cyan,magenta,green \"npm:dev:website\" \"npm:dev:admin\" \"npm:dev:business\"",
    "dev:website": "npm run dev -w @sheetal/website",
    "dev:admin": "npm run dev -w @sheetal/admin",
    "dev:business": "npm run dev -w @sheetal/business",
    "build": "npm run sitemap && npm run build -w @sheetal/website && npm run build -w @sheetal/admin && npm run build -w @sheetal/business && node scripts/assemble.mjs",
    "preview": "npx vite preview --outDir dist --port 4173",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p backend/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run test",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "dev:api": "npm run dev -w @sheetal/api",
    "db:local": "npm run db:local -w @sheetal/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.5"
  }
}
