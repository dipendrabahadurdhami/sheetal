# Local settings for the mail server (shared ones come from backend-core/.env). Copy to mail-server/.env.
# Locally use a high port; on the server it is 25 (see docs/mail-server.md).
SMTP_PORT=2525
SMTP_BIND=127.0.0.1
BUSINESS_API_URL=http://localhost:4001/v1
# Locally, keep sending paused so nothing goes out to the internet by accident.
OUTBOUND_EVERY=3600
