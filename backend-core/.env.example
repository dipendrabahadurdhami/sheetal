# Local settings shared by the three APIs. Copy to backend-core/.env (git-ignored).
NODE_ENV=development
HOST=127.0.0.1
# Ports: website 4000, business 4001, admin 4002 (change with WEBSITE_API_PORT, BUSINESS_API_PORT, ADMIN_API_PORT).
LOG_LEVEL=info
# From `npm run db:local` (local-only password, not used anywhere else):
DATABASE_URL=postgresql://sheetal:sheetal_local@localhost:5433/sheetal
# Leave empty locally (in-memory cache); set on the server:
REDIS_URL=
CORS_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173
API_URL=http://localhost:4000

# Property photos: the old site's images folder locally (contains property/main, property/thumbnail).
MEDIA_DIR=

# Key that encrypts secrets stored in the database (domain signing keys). At least 32 characters; required in production.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRETS_KEY=
# Business email: the mail server's host name (every business domain's MX points here), and the secret the
# mail server uses to hand incoming mail to the business API (POST /v1/mail/inbound).
MAIL_HOST=mail.sheetalproperty.com
MAIL_INBOUND_SECRET=
