// Sheetal Property database. Models are added module by module (see docs/backend-plan.md phases).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Platform-wide settings (site name, VAT, trial days…), one row per key.
/// @app platform
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ───────────── Accounts ─────────────

enum UserStatus {
  active
  suspended
}

/// @app platform
model User {
  id              String     @id @default(cuid())
  /// Always stored lower-case.
  email           String     @unique
  userName        String     @map("user_name")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  phone           String?
  address         String?
  photoUrl        String?    @map("photo_url")
  /// What the person said they are when signing up (buyer, owner, agent…); shown, not used for access.
  userType        String     @default("user") @map("user_type")
  /// Null for accounts imported from the old site until the person sets a new password.
  passwordHash    String?    @map("password_hash")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  status          UserStatus @default(active)
  /// Sheetal staff role (super_admin, operations, finance, content_editor, support); null for everyone else.
  platformRole    String?    @map("platform_role")
  /// Old site's users.id and role, kept for the import and for clarity.
  legacyId        Int?       @unique @map("legacy_id")
  legacyRole      String?    @map("legacy_role")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  sessions    Session[]
  tokens      EmailToken[]
  memberships Membership[]

  @@map("users")
}

/// A logged-in device. The browser holds a random token; only its SHA-256 hash is stored.
/// @app platform
model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum TokenPurpose {
  verify_email
  reset_password
}

/// One-time links sent by email (verify address, reset password). Only the hash is stored.
/// @app platform
model EmailToken {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

// ───────────── Businesses, plans, roles ─────────────

/// Starter (free) / Business / Pro for each business type. `limits` and `features` follow shared/src/core/plans.js.
/// @app platform
model Plan {
  id       String   @id
  type     String
  name     String
  /// Rs. per month; longer periods get the PERIODS discount.
  price    Int
  limits   Json
  features Json
  active   Boolean  @default(true)
  sort     Int      @default(0)
  tenants  Tenant[]

  @@map("plans")
}

enum TenantStatus {
  trial
  active
  past_due
  suspended
  cancelled
  pending_verification
}

/// A business workspace (agency, hotel, host, developer, sponsor).
/// @app workspace
model Tenant {
  id               String       @id @default(cuid())
  name             String
  type             String
  city             String?
  email            String?
  phone            String?
  pan              String?
  /// Shown on bills, invoices and the website: street address, VAT registration and the business's own website.
  address          String?
  vatRegistered    Boolean      @default(false) @map("vat_registered")
  website          String?
  /// Business verification (documents checked by Sheetal): none, pending, verified or rejected (with a note).
  verification     String       @default("none")
  verificationNote String?      @map("verification_note")
  verifiedAt       DateTime?    @map("verified_at")
  /// Logo shown on the website and receipts (a website path or a photo address).
  logoUrl          String?      @map("logo_url")
  /// Up to 3 colours read from the logo (or picked), "#RRGGBB": the workspace uses the first for its bars and the second for buttons.
  brandColors      String[]     @default([]) @map("brand_colors")
  planId           String       @map("plan_id")
  plan             Plan         @relation(fields: [planId], references: [id])
  /// Covered by another business's Pro plan (same owner): no bill of its own; it has Pro while that business does.
  coveredById      String?      @map("covered_by_id")
  status           TenantStatus @default(active)
  /// Months paid for (1, 3, 6 or 12).
  period           Int          @default(1)
  renewsAt         DateTime?    @map("renews_at")
  /// Only a super admin can switch this on.
  autoRenew        Boolean      @default(false) @map("auto_renew")
  /// Billing: after the paid period ends, the plan keeps working until graceUntil; then it moves to Starter.
  graceUntil       DateTime?    @map("grace_until")
  /// The last renewal reminder sent ("<renewsAt date>:<days before>"), so each is sent once.
  remindedFor      String?      @map("reminded_for")
  emailVerified    Boolean      @default(false) @map("email_verified")
  /// The business's own settings by section (payments, notifications, listings, documents, branding, checkups);
  /// secrets inside are sealed with SECRETS_KEY (business/backend/src/modules/settings).
  settings         Json         @default("{}")
  /// The start of this business's listing codes (ER in ER-0123); empty = the initials of its name (domain/codes.ts).
  codePrefix       String?      @map("code_prefix")
  /// A throw-away demo business made by "Try the demo" (FRONTEND-KIT.md section 8). Mail, WhatsApp, payments and
  /// integrations do nothing for it. Real businesses are always false.
  demo             Boolean      @default(false)
  /// When the daily demo cleanup job may delete this demo business. Empty for real businesses.
  demoExpiresAt    DateTime?    @map("demo_expires_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  roles            Role[]
  memberships      Membership[]
  invites          Invite[]
  branches         Branch[]
  verificationDocs VerificationDoc[]
  forms            Form[]
  agreements       Agreement[]
  supportTickets   SupportTicket[]

  @@index([type])
  @@index([coveredById])
  @@index([demo, demoExpiresAt])
  @@map("tenants")
}

/// A branch (outlet, office, site) of a business. Team members can be limited to some branches (Membership.scopes
/// holds branch names); a business's work (listings and everything under them, leads, rooms, bookings, POS) belongs
/// to one branch. Every business starts with "Head office".
/// @app workspace
model Branch {
  id        String     @id @default(cuid())
  tenantId  String     @map("tenant_id")
  name      String
  address   String?
  phone     String?
  /// The person in charge (a name, shown on the Branches page).
  manager   String?
  /// The name printed on this branch's receipts.
  receipt   String?
  /// open or closed (closed branches keep their history but can't be picked).
  status    String     @default("open")
  sort      Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listings  Listing[]
  leads     Lead[]
  rooms     Room[]
  bookings  Booking[]
  menuItems MenuItem[]
  shifts    Shift[]
  posBills  PosBill[]
  rateDays  RateDay[]
  roomRules RoomRule[]
  bizInvoices BizInvoice[]
  expenses    Expense[]
  recurringExpenses RecurringExpense[]
  rentOwners  RentOwner[]
  rentUnits   RentUnit[]
  forms       Form[]
  agreements  Agreement[]
  stockItems  StockItem[]
  attendance    Attendance[]
  leaveRequests LeaveRequest[]
  /// The members and pending invites limited to this branch (the join rows go when the branch goes).
  memberLinks MembershipBranch[]
  inviteLinks InviteBranch[]

  @@unique([tenantId, name])
  @@map("branches")
}

/// A document sent for business verification: company registration, PAN/VAT certificate, owner's ID or other.
/// The file is private (MEDIA_DIR/private/kyc), opened only by the business's settings people and Sheetal staff.
/// @app platform
model VerificationDoc {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  kind       String
  file       String
  filename   String?
  size       Int
  uploadedBy String?  @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("verification_docs")
}

/// A role inside one business: a named set of permission ids (see src/domain/permissions.ts).
/// @app workspace
model Role {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  key         String
  name        String?
  system      Boolean      @default(true)
  perms       String[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, key])
  @@map("roles")
}

/// A person in a business, with one role. Which branches they work at: `allBranches` = every branch (now and later),
/// or else only the rows in MembershipBranch (by branch id). `scopes` is the OLD way ("all" or a list of branch names);
/// it stays and is still written for one release (ACCESS.md section 3.4), then it is frozen.
/// @app workspace
model Membership {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  tenantId    String             @map("tenant_id")
  roleId      String             @map("role_id")
  scopes      Json               @default("\"all\"")
  allBranches Boolean            @default(true) @map("all_branches")
  status      String             @default("active")
  createdAt   DateTime           @default(now()) @map("created_at")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role        Role               @relation(fields: [roleId], references: [id])
  branches    MembershipBranch[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

/// One branch a limited member works at (used only when Membership.allBranches is false). Deleting the member or the
/// branch deletes the row. A limited member with no rows has no branch at all (never "all").
/// @app workspace
model MembershipBranch {
  membershipId String     @map("membership_id")
  branchId     String     @map("branch_id")
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([branchId])
  @@map("membership_branches")
}

// ───────────── Email outbox and audit ─────────────

/// Every email the platform sends, queued here first; the mail sender (Cloudflare setup) delivers them.
/// System emails (verify, reset, invites, invoices, reminders). The mail server sends them: queued → sending →
/// sent, or deferred (tried again later) → failed. In development they are saved as files instead of sent.
/// @app platform
model OutboundEmail {
  id            String    @id @default(cuid())
  to            String
  subject       String
  text          String
  html          String?
  status        String    @default("queued")
  error         String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lockedUntil   DateTime? @map("locked_until")
  /// The receiving server's answer, or where the file was saved in development.
  response      String?
  createdAt     DateTime  @default(now()) @map("created_at")
  sentAt        DateTime? @map("sent_at")

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@map("outbound_emails")
}

/// Who did what, for the admin audit log and business activity.
/// @app platform
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  tenantId  String?  @map("tenant_id")
  action    String
  target    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ───────────── Listings (properties for sale and rent) ─────────────

enum ListingPurpose {
  sale
  rent
}

/// draft → pending (Sheetal checks it) → published, or rejected with a note. A business can pause or archive its own
/// listings; removed ones are kept only so leads and history still point somewhere.
enum ListingStatus {
  draft
  pending
  published
  sold
  rented
  expired
  removed
  paused
  rejected
  archived
}

/// One table for every property, posted from /business and shown on the website.
/// Public fields are columns; `details` holds the rest of what visitors may see; `private` never leaves the server.
/// @app listings
model Listing {
  id            Int            @id @default(autoincrement())
  /// Shown to people and used in links: SP-0006.
  code          String         @unique
  /// Codes this listing had before (a business changed its prefix); they still find it on the website.
  oldCodes      String[]       @default([]) @map("old_codes")
  slug          String         @unique
  tenantId      String?        @map("tenant_id")
  /// The branch it belongs to (see Branch); null = no business, or shared by all branches where noted.
  branchId      String?        @map("branch_id")
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// The person who posted it (imported listings keep their old poster).
  userId        String?        @map("user_id")
  /// What is offered, as in /business: sell, rentout, stay_hotel, stay_unit, project, invest
  /// (shared/src/data/catalog.js listingKinds). `purpose` says whether the deal is a sale or a rent.
  kind          String         @default("sell")
  purpose       ListingPurpose
  /// House, Land, Apartment, Office space… (see catalog in shared/src/data/catalog.js).
  category      String
  propertyType  String?        @map("property_type")
  title         String
  /// Sanitised HTML.
  description   String?
  highlights    String?
  status        ListingStatus  @default(draft)
  /// Rs. Total price for sale; monthly rent for rent.
  price         BigInt?
  pricePer      String?        @map("price_per")
  negotiable    Boolean        @default(false)
  province      String?
  district      String?
  city          String?
  /// Neighbourhood (tol) as people say it: "Dhapasi, Tillingtar".
  area          String?
  street        String?
  ward          String?
  /// Exact point. Sale and rent listings are only ever sent as an approximate area (see website/backend geo).
  lat           Float?
  lng           Float?
  bedrooms      Int?
  bathrooms     Int?
  kitchens      Int?
  livingRooms   Int?           @map("living_rooms")
  floors        Float?
  parking       String?
  /// As written by the owner ("3 Aana 1 Paisa"); `landSqft` is the same size in sq ft for filters.
  landArea      String?        @map("land_area")
  landSqft      Float?         @map("land_sqft")
  builtArea     String?        @map("built_area")
  roadAccess    String?        @map("road_access")
  roadType      String?        @map("road_type")
  facing        String?
  builtYear     String?        @map("built_year")
  furnishing    String?
  facilities    String[]       @default([])
  youtubeUrl    String?        @map("youtube_url")
  details       Json           @default("{}")
  /// Owner name and phone, lalpurja number, commission, internal notes. Never sent to the website.
  private       Json           @default("{}")
  featured      Boolean        @default(false)
  featuredOrder Int            @default(0) @map("featured_order")
  views         Int            @default(0)
  /// Fixes proposed from the title and description (import or AI) for a person to accept.
  suggest       Json?
  /// Check-ups: the next date someone should confirm it is still correct (listings never expire on their own).
  checkDueAt    DateTime?      @map("check_due_at")
  lastCheckedAt DateTime?      @map("last_checked_at")
  lastCheckedBy String?        @map("last_checked_by")
  /// A reviewer changed something today: off the website until the changes are decided (the team keeps working on it).
  reviewHold     Boolean       @default(false) @map("review_hold")
  /// Fields reviewers disagreed on, waiting for the owner: { field: [{ value, by: [userId] }] }.
  reviewConflict Json?         @map("review_conflict")
  /// Sheetal's review: when it was sent for review, who decided, and the note sent back when changes are needed.
  submittedAt   DateTime?      @map("submitted_at")
  reviewedAt    DateTime?      @map("reviewed_at")
  reviewedBy    String?        @map("reviewed_by")
  reviewNote    String?        @map("review_note")
  legacyId      Int?           @unique @map("legacy_id")
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  photos        ListingPhoto[]

  @@index([status, kind, publishedAt])
  @@index([status, purpose, publishedAt])
  @@index([status, featured, featuredOrder])
  @@index([district])
  @@index([category])
  @@index([tenantId, status])
  @@index([userId])
  @@index([status, submittedAt])
  @@index([branchId])
  @@map("listings")
}

/// Photos in display order; `file` is the name inside the media store (main, thumbnail and original sizes share it).
/// @app listings
model ListingPhoto {
  id        Int     @id @default(autoincrement())
  listingId Int     @map("listing_id")
  file      String
  sort      Int     @default(0)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sort])
  @@map("listing_photos")
}

// ───────────── Business email (own domains, own mail server) ─────────────
// A business connects its domain, proves it with DNS records, then gives each team member a mailbox.
// Paid plans only; storage is counted per business (all mailboxes together).

/// A business's own domain for email. Mailboxes can be created only once it is verified.
/// @app workspace
model MailDomain {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  /// Always lower-case, e.g. "everestinn.com".
  name           String    @unique
  verified       Boolean   @default(false)
  /// Proof the business owns the domain (a TXT record).
  verifyToken    String    @map("verify_token")
  dkimSelector   String    @default("sheetal") @map("dkim_selector")
  dkimPublicKey  String    @map("dkim_public_key")
  /// Encrypted with SECRETS_KEY (backend-core/src/lib/vault.ts).
  dkimPrivateKey String    @map("dkim_private_key")
  /// Last DNS check: record id → "ok" | "missing" | "wrong".
  checks         Json      @default("{}")
  checkedAt      DateTime? @map("checked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  mailboxes      Mailbox[]

  @@index([tenantId])
  @@map("mail_domains")
}

/// An address on a business domain: one person's mailbox, or a shared one (info@, sales@) several people answer.
/// @app workspace
model Mailbox {
  id        String          @id @default(cuid())
  tenantId  String          @map("tenant_id")
  domainId  String          @map("domain_id")
  /// Full address, lower-case: "ram@everestinn.com".
  address   String          @unique
  name      String
  /// "person" or "shared".
  kind      String          @default("person")
  /// The team member a personal mailbox belongs to.
  userId    String?         @map("user_id")
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")
  domain    MailDomain      @relation(fields: [domainId], references: [id], onDelete: Cascade)
  access    MailboxAccess[]
  messages  MailMessage[]

  @@index([tenantId])
  @@index([userId])
  @@map("mailboxes")
}

/// Who else may use a mailbox (the people who answer a shared address).
/// @app workspace
model MailboxAccess {
  mailboxId String  @map("mailbox_id")
  userId    String  @map("user_id")
  mailbox   Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@id([mailboxId, userId])
  @@index([userId])
  @@map("mailbox_access")
}

/// One email in one mailbox. A message sent to a teammate is stored twice: in the sender's Sent and the teammate's Inbox.
/// @app workspace
model MailMessage {
  id          String           @id @default(cuid())
  mailboxId   String           @map("mailbox_id")
  tenantId    String           @map("tenant_id")
  /// inbox, sent, drafts, archive, spam, trash
  folder      String
  /// Replies share the thread of the message they answer.
  threadId    String           @map("thread_id")
  /// The internet Message-ID header, for replies across servers.
  messageId   String           @map("message_id")
  inReplyTo   String?          @map("in_reply_to")
  fromAddress String           @map("from_address")
  fromName    String?          @map("from_name")
  to          String[]         @default([])
  cc          String[]         @default([])
  bcc         String[]         @default([])
  subject     String           @default("")
  text        String           @default("")
  /// Sanitised HTML, when the mail has it.
  html        String?
  snippet     String           @default("")
  /// Bytes counted against the business's storage (body plus attachments).
  size        Int              @default(0)
  seen        Boolean          @default(false)
  starred     Boolean          @default(false)
  /// received, draft, delivered (to a teammate), queued (for the mail server), sent, failed
  status      String
  error       String?
  sentAt      DateTime?        @map("sent_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  mailbox     Mailbox          @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  attachments MailAttachment[]
  deliveries  MailDelivery[]

  @@index([mailboxId, folder, createdAt])
  @@index([tenantId])
  @@index([threadId])
  @@index([status])
  @@map("mail_messages")
}

/// @app workspace
model MailAttachment {
  id          String      @id @default(cuid())
  messageId   String      @map("message_id")
  filename    String
  contentType String      @map("content_type")
  size        Int
  /// Kept in the database for now; moves to object storage with photos later.
  data        Bytes
  message     MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("mail_attachments")
}

/// One outside recipient of a sent email, worked through by the mail server: queued → sending → sent,
/// or deferred (temporary problem, tried again later) → failed after the last attempt or a permanent refusal.
/// @app workspace
model MailDelivery {
  id            String      @id @default(cuid())
  messageId     String      @map("message_id")
  tenantId      String      @map("tenant_id")
  recipient     String
  status        String      @default("queued")
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at")
  /// Set while a mail server works on it, so two servers never send the same mail.
  lockedUntil   DateTime?   @map("locked_until")
  lastError     String?     @map("last_error")
  /// The receiving server's last reply, e.g. "250 2.0.0 OK".
  response      String?
  sentAt        DateTime?   @map("sent_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  message       MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([messageId])
  @@map("mail_deliveries")
}

// ───────────── Website: favourites, enquiries, reviews, upgrades ─────────────

/// A listing someone saved.
/// @app listings
model Favourite {
  userId    String   @map("user_id")
  listingId Int      @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, listingId])
  @@index([listingId])
  @@map("favourites")
}

/// An enquiry from the website: contact the agency or owner, a site visit, a buyer requirement, a service request.
/// It goes to the business that owns the listing (or to Sheetal when there is none) and shows in its Inbox.
/// @app crm
model Lead {
  id         String        @id @default(cuid())
  /// The business it is for; null = Sheetal itself.
  tenantId   String?       @map("tenant_id")
  /// The branch handling it: the listing's branch, or where it came in.
  branchId   String?       @map("branch_id")
  branch     Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  listingId  Int?          @map("listing_id")
  userId     String?       @map("user_id")
  /// contact_agent, contact_owner, site_visit, requirement, service
  kind       String
  name       String
  email      String?
  phone      String?
  message    String        @default("")
  /// Everything else the form sent (reasons, budget, preferred time…).
  details    Json          @default("{}")
  /// Pipeline stage: new, contacted, viewing, negotiating, won, lost
  status     String        @default("new")
  /// The team member following it up (a user id), the next follow-up date, tags and the deal value in Rs.
  assigneeId String?       @map("assignee_id")
  followAt   DateTime?     @map("follow_at")
  tags       String[]      @default([])
  value      BigInt?
  /// When the business last opened it; newer messages count as unread.
  readAt     DateTime?     @map("read_at")
  /// Buyer requirements: shown on the website's requirement board (never with contact details) once any fee is confirmed.
  public     Boolean       @default(false)
  /// Requirement fee: pending (proof sent), confirmed or rejected by Sheetal; the amount in Rs., the payment
  /// reference and the proof image (a private file, never served publicly).
  feeStatus  String?       @map("fee_status")
  feeAmount  Int?          @map("fee_amount")
  feeRef     String?       @map("fee_ref")
  feeProof   String?       @map("fee_proof")
  legacyId   Int?          @unique @map("legacy_id")
  /// For chats: the channel and the person's id there ("whatsapp:9779800000000"), so new messages join the same lead.
  contactKey String?       @map("contact_key")
  /// Short public number: REQ-0042 on the requirement board.
  ref        Int           @unique @default(autoincrement())
  lastAt     DateTime      @default(now()) @map("last_at")
  ip         String?
  createdAt  DateTime      @default(now()) @map("created_at")
  messages   LeadMessage[]
  matches    DemandMatch[]

  @@index([kind, public, createdAt])
  @@index([tenantId, contactKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, lastAt])
  @@index([listingId])
  @@index([branchId])
  @@map("leads")
}

/// Replies on a lead: "in" from the person (the first message is the lead itself), "out" from the business (sent by email).
/// @app crm
model LeadMessage {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  direction String
  body      String
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_messages")
}

/// A star rating with a comment, for a listing or for a business. One per person per listing or business.
/// @app reviews
model Review {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  listingId Int?      @map("listing_id")
  tenantId  String?   @map("tenant_id")
  rating    Int
  comment   String    @default("")
  /// published or hidden (by the business or Sheetal)
  status    String    @default("published")
  /// The business's public answer, when and by whom.
  reply     String?
  repliedAt DateTime? @map("replied_at")
  repliedBy String?   @map("replied_by")
  /// Who last changed the row (kernel columns, KERNEL.md section 6.1). The writer of a review is userId; createdBy is the
  /// same person for reviews written through the kernel, empty for older rows.
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  /// Starts at 1 and goes up by 1 on every change; a save made on an older version is refused (KERNEL.md section 6).
  version   Int       @default(1)
  /// Soft delete (Sheetal removes a review for good, e.g. spam or a legal request). Empty = not deleted.
  /// "Hidden" is a status and stays visible to the business; deleted rows are hidden from every query.
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([userId, listingId])
  @@unique([userId, tenantId])
  @@index([listingId, status])
  @@index([tenantId, status])
  @@map("reviews")
}

/// A business asking to move to a paid plan; Sheetal's team follows up and takes payment.
/// @app platform
model UpgradeRequest {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  planId    String   @map("plan_id")
  months    Int
  /// pending, done, declined
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("upgrade_requests")
}

/// An invitation to join a business's team, sent by email. Only the hash of the link's token is stored.
/// @app workspace
model Invite {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  /// Lower-case.
  email       String
  roleId      String         @map("role_id")
  /// The OLD way to say which branches ("all" or a list of branch names); see Membership.
  scopes      Json           @default("\"all\"")
  /// true = every branch; false = only the rows in InviteBranch (by branch id).
  allBranches Boolean        @default(true) @map("all_branches")
  tokenHash   String         @unique @map("token_hash")
  invitedBy   String?        @map("invited_by")
  /// pending, accepted, revoked
  status      String         @default("pending")
  expiresAt   DateTime       @map("expires_at")
  sentAt      DateTime       @default(now()) @map("sent_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches    InviteBranch[]

  @@index([tenantId, status])
  @@index([email])
  @@map("invites")
}

/// One branch a limited invitation gives (used only when Invite.allBranches is false). Only pending invitations are
/// filled in by the migration. Deleting the invitation or the branch deletes the row.
/// @app workspace
model InviteBranch {
  inviteId String @map("invite_id")
  branchId String @map("branch_id")
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([inviteId, branchId])
  @@index([branchId])
  @@map("invite_branches")
}

// ───────────── Requirement board, notifications ─────────────

/// An agent or owner offering one of their listings for a buyer's requirement. The buyer is told by email and notification.
/// @app listings
model DemandMatch {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  listingId Int      @map("listing_id")
  userId    String   @map("user_id")
  message   String   @default("")
  /// sent, seen, interested, declined
  status    String   @default("sent")
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, listingId])
  @@index([userId])
  @@map("demand_matches")
}

/// Something a person should know: listing approved, new offer on their requirement, new enquiry…
/// @app workspace
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  /// The business it is about (its panel bell shows it); null = the person's own (website) or Sheetal staff's (admin).
  tenantId  String?   @map("tenant_id")
  type      String
  title     String
  message   String    @default("")
  /// Where it leads in the website or a panel, e.g. /property/… or /business/inbox.
  link      String?
  readAt    DateTime? @map("read_at")
