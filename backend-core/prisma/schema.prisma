// Sheetal Property database. Models are added module by module (see docs/backend-plan.md phases).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Platform-wide settings (site name, VAT, trial days…), one row per key.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ───────────── Accounts ─────────────

enum UserStatus {
  active
  suspended
}

model User {
  id              String     @id @default(cuid())
  /// Always stored lower-case.
  email           String     @unique
  userName        String     @map("user_name")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  phone           String?
  address         String?
  photoUrl        String?    @map("photo_url")
  /// What the person said they are when signing up (buyer, owner, agent…); shown, not used for access.
  userType        String     @default("user") @map("user_type")
  /// Null for accounts imported from the old site until the person sets a new password.
  passwordHash    String?    @map("password_hash")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  status          UserStatus @default(active)
  /// Sheetal staff role (super_admin, operations, finance, content_editor, support); null for everyone else.
  platformRole    String?    @map("platform_role")
  /// Old site's users.id and role, kept for the import and for clarity.
  legacyId        Int?       @unique @map("legacy_id")
  legacyRole      String?    @map("legacy_role")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  sessions    Session[]
  tokens      EmailToken[]
  memberships Membership[]

  @@map("users")
}

/// A logged-in device. The browser holds a random token; only its SHA-256 hash is stored.
model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum TokenPurpose {
  verify_email
  reset_password
}

/// One-time links sent by email (verify address, reset password). Only the hash is stored.
model EmailToken {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

// ───────────── Businesses, plans, roles ─────────────

/// Starter (free) / Business / Pro for each business type. `limits` and `features` follow shared/src/core/plans.js.
model Plan {
  id       String   @id
  type     String
  name     String
  /// Rs. per month; longer periods get the PERIODS discount.
  price    Int
  limits   Json
  features Json
  active   Boolean  @default(true)
  sort     Int      @default(0)
  tenants  Tenant[]

  @@map("plans")
}

enum TenantStatus {
  trial
  active
  past_due
  suspended
  cancelled
  pending_verification
}

/// A business workspace (agency, hotel, host, developer, sponsor).
model Tenant {
  id            String       @id @default(cuid())
  name          String
  type          String
  city          String?
  email         String?
  phone         String?
  pan           String?
  /// Shown on bills, invoices and the website: street address, VAT registration and the business's own website.
  address       String?
  vatRegistered Boolean      @default(false) @map("vat_registered")
  website       String?
  /// Logo shown on the website and receipts (a website path or a photo address).
  logoUrl       String?      @map("logo_url")
  /// Up to 3 colours read from the logo (or picked), "#RRGGBB": the workspace uses the first for its bars and the second for buttons.
  brandColors   String[]     @default([]) @map("brand_colors")
  planId        String       @map("plan_id")
  plan          Plan         @relation(fields: [planId], references: [id])
  /// Covered by another business's Pro plan (same owner): no bill of its own; it has Pro while that business does.
  coveredById   String?      @map("covered_by_id")
  status        TenantStatus @default(active)
  /// Months paid for (1, 3, 6 or 12).
  period        Int          @default(1)
  renewsAt      DateTime?    @map("renews_at")
  /// Only a super admin can switch this on.
  autoRenew     Boolean      @default(false) @map("auto_renew")
  /// Billing: after the paid period ends, the plan keeps working until graceUntil; then it moves to Starter.
  graceUntil    DateTime?    @map("grace_until")
  /// The last renewal reminder sent ("<renewsAt date>:<days before>"), so each is sent once.
  remindedFor   String?      @map("reminded_for")
  emailVerified Boolean      @default(false) @map("email_verified")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  roles       Role[]
  memberships Membership[]
  invites     Invite[]
  branches    Branch[]

  @@index([type])
  @@index([coveredById])
  @@map("tenants")
}

/// A branch (outlet, office, site) of a business. Team members can be limited to some branches (Membership.scopes
/// holds branch names); a business's work (listings and everything under them, leads, rooms, bookings, POS) belongs
/// to one branch. Every business starts with "Head office".
model Branch {
  id        String     @id @default(cuid())
  tenantId  String     @map("tenant_id")
  name      String
  address   String?
  phone     String?
  /// The person in charge (a name, shown on the Branches page).
  manager   String?
  /// The name printed on this branch's receipts.
  receipt   String?
  /// open or closed (closed branches keep their history but can't be picked).
  status    String     @default("open")
  sort      Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listings  Listing[]
  leads     Lead[]
  rooms     Room[]
  bookings  Booking[]
  menuItems MenuItem[]
  shifts    Shift[]
  posBills  PosBill[]

  @@unique([tenantId, name])
  @@map("branches")
}

/// A role inside one business: a named set of permission ids (see src/domain/permissions.ts).
model Role {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  key         String
  name        String?
  system      Boolean      @default(true)
  perms       String[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, key])
  @@map("roles")
}

/// A person in a business, with one role. `scopes` = "all" or a list of branches.
model Membership {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  roleId    String   @map("role_id")
  scopes    Json     @default("\"all\"")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

// ───────────── Email outbox and audit ─────────────

/// Every email the platform sends, queued here first; the mail sender (Cloudflare setup) delivers them.
/// System emails (verify, reset, invites, invoices, reminders). The mail server sends them: queued → sending →
/// sent, or deferred (tried again later) → failed. In development they are saved as files instead of sent.
model OutboundEmail {
  id            String    @id @default(cuid())
  to            String
  subject       String
  text          String
  html          String?
  status        String    @default("queued")
  error         String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lockedUntil   DateTime? @map("locked_until")
  /// The receiving server's answer, or where the file was saved in development.
  response      String?
  createdAt     DateTime  @default(now()) @map("created_at")
  sentAt        DateTime? @map("sent_at")

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@map("outbound_emails")
}

/// Who did what, for the admin audit log and business activity.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  tenantId  String?  @map("tenant_id")
  action    String
  target    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ───────────── Listings (properties for sale and rent) ─────────────

enum ListingPurpose {
  sale
  rent
}

/// draft → pending (Sheetal checks it) → published, or rejected with a note. A business can pause or archive its own
/// listings; removed ones are kept only so leads and history still point somewhere.
enum ListingStatus {
  draft
  pending
  published
  sold
  rented
  expired
  removed
  paused
  rejected
  archived
}

/// One table for every property, posted from /business and shown on the website.
/// Public fields are columns; `details` holds the rest of what visitors may see; `private` never leaves the server.
model Listing {
  id            Int            @id @default(autoincrement())
  /// Shown to people and used in links: SP-0006.
  code          String         @unique
  slug          String         @unique
  tenantId      String?        @map("tenant_id")
  /// The branch it belongs to (see Branch); null = no business, or shared by all branches where noted.
  branchId      String?        @map("branch_id")
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// The person who posted it (imported listings keep their old poster).
  userId        String?        @map("user_id")
  /// What is offered, as in /business: sell, rentout, stay_hotel, stay_unit, project, invest
  /// (shared/src/data/catalog.js listingKinds). `purpose` says whether the deal is a sale or a rent.
  kind          String         @default("sell")
  purpose       ListingPurpose
  /// House, Land, Apartment, Office space… (see catalog in shared/src/data/catalog.js).
  category      String
  propertyType  String?        @map("property_type")
  title         String
  /// Sanitised HTML.
  description   String?
  highlights    String?
  status        ListingStatus  @default(draft)
  /// Rs. Total price for sale; monthly rent for rent.
  price         BigInt?
  pricePer      String?        @map("price_per")
  negotiable    Boolean        @default(false)
  province      String?
  district      String?
  city          String?
  /// Neighbourhood (tol) as people say it: "Dhapasi, Tillingtar".
  area          String?
  street        String?
  ward          String?
  /// Exact point. Sale and rent listings are only ever sent as an approximate area (see website/backend geo).
  lat           Float?
  lng           Float?
  bedrooms      Int?
  bathrooms     Int?
  kitchens      Int?
  livingRooms   Int?           @map("living_rooms")
  floors        Float?
  parking       String?
  /// As written by the owner ("3 Aana 1 Paisa"); `landSqft` is the same size in sq ft for filters.
  landArea      String?        @map("land_area")
  landSqft      Float?         @map("land_sqft")
  builtArea     String?        @map("built_area")
  roadAccess    String?        @map("road_access")
  roadType      String?        @map("road_type")
  facing        String?
  builtYear     String?        @map("built_year")
  furnishing    String?
  facilities    String[]       @default([])
  youtubeUrl    String?        @map("youtube_url")
  details       Json           @default("{}")
  /// Owner name and phone, lalpurja number, commission, internal notes. Never sent to the website.
  private       Json           @default("{}")
  featured      Boolean        @default(false)
  featuredOrder Int            @default(0) @map("featured_order")
  views         Int            @default(0)
  /// Fixes proposed from the title and description (import or AI) for a person to accept.
  suggest       Json?
  /// Check-ups: the next date someone should confirm it is still correct (listings never expire on their own).
  checkDueAt    DateTime?      @map("check_due_at")
  lastCheckedAt DateTime?      @map("last_checked_at")
  lastCheckedBy String?        @map("last_checked_by")
  /// Sheetal's review: when it was sent for review, who decided, and the note sent back when changes are needed.
  submittedAt   DateTime?      @map("submitted_at")
  reviewedAt    DateTime?      @map("reviewed_at")
  reviewedBy    String?        @map("reviewed_by")
  reviewNote    String?        @map("review_note")
  legacyId      Int?           @unique @map("legacy_id")
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  photos        ListingPhoto[]

  @@index([status, kind, publishedAt])
  @@index([status, purpose, publishedAt])
  @@index([status, featured, featuredOrder])
  @@index([district])
  @@index([category])
  @@index([tenantId, status])
  @@index([userId])
  @@index([status, submittedAt])
  @@index([branchId])
  @@map("listings")
}

/// Photos in display order; `file` is the name inside the media store (main, thumbnail and original sizes share it).
model ListingPhoto {
  id        Int     @id @default(autoincrement())
  listingId Int     @map("listing_id")
  file      String
  sort      Int     @default(0)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sort])
  @@map("listing_photos")
}

// ───────────── Business email (own domains, own mail server) ─────────────
// A business connects its domain, proves it with DNS records, then gives each team member a mailbox.
// Paid plans only; storage is counted per business (all mailboxes together).

/// A business's own domain for email. Mailboxes can be created only once it is verified.
model MailDomain {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  /// Always lower-case, e.g. "everestinn.com".
  name           String    @unique
  verified       Boolean   @default(false)
  /// Proof the business owns the domain (a TXT record).
  verifyToken    String    @map("verify_token")
  dkimSelector   String    @default("sheetal") @map("dkim_selector")
  dkimPublicKey  String    @map("dkim_public_key")
  /// Encrypted with SECRETS_KEY (backend-core/src/lib/vault.ts).
  dkimPrivateKey String    @map("dkim_private_key")
  /// Last DNS check: record id → "ok" | "missing" | "wrong".
  checks         Json      @default("{}")
  checkedAt      DateTime? @map("checked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  mailboxes      Mailbox[]

  @@index([tenantId])
  @@map("mail_domains")
}

/// An address on a business domain: one person's mailbox, or a shared one (info@, sales@) several people answer.
model Mailbox {
  id        String          @id @default(cuid())
  tenantId  String          @map("tenant_id")
  domainId  String          @map("domain_id")
  /// Full address, lower-case: "ram@everestinn.com".
  address   String          @unique
  name      String
  /// "person" or "shared".
  kind      String          @default("person")
  /// The team member a personal mailbox belongs to.
  userId    String?         @map("user_id")
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")
  domain    MailDomain      @relation(fields: [domainId], references: [id], onDelete: Cascade)
  access    MailboxAccess[]
  messages  MailMessage[]

  @@index([tenantId])
  @@index([userId])
  @@map("mailboxes")
}

/// Who else may use a mailbox (the people who answer a shared address).
model MailboxAccess {
  mailboxId String  @map("mailbox_id")
  userId    String  @map("user_id")
  mailbox   Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@id([mailboxId, userId])
  @@index([userId])
  @@map("mailbox_access")
}

/// One email in one mailbox. A message sent to a teammate is stored twice: in the sender's Sent and the teammate's Inbox.
model MailMessage {
  id          String           @id @default(cuid())
  mailboxId   String           @map("mailbox_id")
  tenantId    String           @map("tenant_id")
  /// inbox, sent, drafts, archive, spam, trash
  folder      String
  /// Replies share the thread of the message they answer.
  threadId    String           @map("thread_id")
  /// The internet Message-ID header, for replies across servers.
  messageId   String           @map("message_id")
  inReplyTo   String?          @map("in_reply_to")
  fromAddress String           @map("from_address")
  fromName    String?          @map("from_name")
  to          String[]         @default([])
  cc          String[]         @default([])
  bcc         String[]         @default([])
  subject     String           @default("")
  text        String           @default("")
  /// Sanitised HTML, when the mail has it.
  html        String?
  snippet     String           @default("")
  /// Bytes counted against the business's storage (body plus attachments).
  size        Int              @default(0)
  seen        Boolean          @default(false)
  starred     Boolean          @default(false)
  /// received, draft, delivered (to a teammate), queued (for the mail server), sent, failed
  status      String
  error       String?
  sentAt      DateTime?        @map("sent_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  mailbox     Mailbox          @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  attachments MailAttachment[]
  deliveries  MailDelivery[]

  @@index([mailboxId, folder, createdAt])
  @@index([tenantId])
  @@index([threadId])
  @@index([status])
  @@map("mail_messages")
}

model MailAttachment {
  id          String      @id @default(cuid())
  messageId   String      @map("message_id")
  filename    String
  contentType String      @map("content_type")
  size        Int
  /// Kept in the database for now; moves to object storage with photos later.
  data        Bytes
  message     MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("mail_attachments")
}

/// One outside recipient of a sent email, worked through by the mail server: queued → sending → sent,
/// or deferred (temporary problem, tried again later) → failed after the last attempt or a permanent refusal.
model MailDelivery {
  id            String      @id @default(cuid())
  messageId     String      @map("message_id")
  tenantId      String      @map("tenant_id")
  recipient     String
  status        String      @default("queued")
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at")
  /// Set while a mail server works on it, so two servers never send the same mail.
  lockedUntil   DateTime?   @map("locked_until")
  lastError     String?     @map("last_error")
  /// The receiving server's last reply, e.g. "250 2.0.0 OK".
  response      String?
  sentAt        DateTime?   @map("sent_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  message       MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([messageId])
  @@map("mail_deliveries")
}

// ───────────── Website: favourites, enquiries, reviews, upgrades ─────────────

/// A listing someone saved.
model Favourite {
  userId    String   @map("user_id")
  listingId Int      @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, listingId])
  @@index([listingId])
  @@map("favourites")
}

/// An enquiry from the website: contact the agency or owner, a site visit, a buyer requirement, a service request.
/// It goes to the business that owns the listing (or to Sheetal when there is none) and shows in its Inbox.
model Lead {
  id         String        @id @default(cuid())
  /// The business it is for; null = Sheetal itself.
  tenantId   String?       @map("tenant_id")
  /// The branch handling it: the listing's branch, or where it came in.
  branchId   String?       @map("branch_id")
  branch     Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  listingId  Int?          @map("listing_id")
  userId     String?       @map("user_id")
  /// contact_agent, contact_owner, site_visit, requirement, service
  kind       String
  name       String
  email      String?
  phone      String?
  message    String        @default("")
  /// Everything else the form sent (reasons, budget, preferred time…).
  details    Json          @default("{}")
  /// Pipeline stage: new, contacted, viewing, negotiating, won, lost
  status     String        @default("new")
  /// The team member following it up (a user id), the next follow-up date, tags and the deal value in Rs.
  assigneeId String?       @map("assignee_id")
  followAt   DateTime?     @map("follow_at")
  tags       String[]      @default([])
  value      BigInt?
  /// When the business last opened it; newer messages count as unread.
  readAt     DateTime?     @map("read_at")
  /// Buyer requirements: shown on the website's requirement board (never with contact details) once any fee is confirmed.
  public     Boolean       @default(false)
  /// Requirement fee: pending (proof sent), confirmed or rejected by Sheetal; the amount in Rs., the payment
  /// reference and the proof image (a private file, never served publicly).
  feeStatus  String?       @map("fee_status")
  feeAmount  Int?          @map("fee_amount")
  feeRef     String?       @map("fee_ref")
  feeProof   String?       @map("fee_proof")
  legacyId   Int?          @unique @map("legacy_id")
  /// For chats: the channel and the person's id there ("whatsapp:9779800000000"), so new messages join the same lead.
  contactKey String?       @map("contact_key")
  /// Short public number: REQ-0042 on the requirement board.
  ref        Int           @unique @default(autoincrement())
  lastAt     DateTime      @default(now()) @map("last_at")
  ip         String?
  createdAt  DateTime      @default(now()) @map("created_at")
  messages   LeadMessage[]
  matches    DemandMatch[]

  @@index([kind, public, createdAt])
  @@index([tenantId, contactKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, lastAt])
  @@index([listingId])
  @@index([branchId])
  @@map("leads")
}

/// Replies on a lead: "in" from the person (the first message is the lead itself), "out" from the business (sent by email).
model LeadMessage {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  direction String
  body      String
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_messages")
}

/// A star rating with a comment, for a listing or for a business. One per person per listing or business.
model Review {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  listingId Int?     @map("listing_id")
  tenantId  String?  @map("tenant_id")
  rating    Int
  comment   String   @default("")
  /// published or hidden (by the business or Sheetal)
  status    String   @default("published")
  /// The business's public answer.
  reply     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, listingId])
  @@unique([userId, tenantId])
  @@index([listingId, status])
  @@index([tenantId, status])
  @@map("reviews")
}

/// A business asking to move to a paid plan; Sheetal's team follows up and takes payment.
model UpgradeRequest {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  planId    String   @map("plan_id")
  months    Int
  /// pending, done, declined
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("upgrade_requests")
}

/// An invitation to join a business's team, sent by email. Only the hash of the link's token is stored.
model Invite {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  /// Lower-case.
  email     String
  roleId    String   @map("role_id")
  scopes    Json     @default("\"all\"")
  tokenHash String   @unique @map("token_hash")
  invitedBy String?  @map("invited_by")
  /// pending, accepted, revoked
  status    String   @default("pending")
  expiresAt DateTime @map("expires_at")
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([email])
  @@map("invites")
}

// ───────────── Requirement board, notifications ─────────────

/// An agent or owner offering one of their listings for a buyer's requirement. The buyer is told by email and notification.
model DemandMatch {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  listingId Int      @map("listing_id")
  userId    String   @map("user_id")
  message   String   @default("")
  /// sent, seen, interested, declined
  status    String   @default("sent")
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, listingId])
  @@index([userId])
  @@map("demand_matches")
}

/// Something a person should know: listing approved, new offer on their requirement, new enquiry…
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  message   String    @default("")
  /// Where it leads in the website or a panel, e.g. /property/… or /business/inbox.
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}

// ───────────── Blog and careers ─────────────

model BlogCategory {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  active      Boolean    @default(true)
  legacyId    Int?       @unique @map("legacy_id")
  posts       BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id              Int           @id @default(autoincrement())
  categoryId      Int?          @map("category_id")
  authorId        String?       @map("author_id")
  title           String
  slug            String        @unique
  /// Sanitised HTML.
  content         String
  excerpt         String?
  /// A file in MEDIA_DIR/blog, or a full URL.
  image           String?
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description")
  tags            String[]      @default([])
  /// draft, published
  status          String        @default("draft")
  allowComments   Boolean       @default(true) @map("allow_comments")
  publishedAt     DateTime?     @map("published_at")
  views           Int           @default(0)
  legacyId        Int?          @unique @map("legacy_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments        BlogComment[]

  @@index([status, publishedAt])
  @@map("blog_posts")
}

/// Comments wait for Sheetal to approve them before they show.
model BlogComment {
  id        String   @id @default(cuid())
  postId    Int      @map("post_id")
  userId    String?  @map("user_id")
  name      String
  email     String?
  comment   String
  /// pending, approved, rejected
  status    String   @default("pending")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, status])
  @@index([status, createdAt])
  @@map("blog_comments")
}

model JobPost {
  id               Int              @id @default(autoincrement())
  title            String
  slug             String           @unique
  department       String?
  /// full_time, part_time, contract, internship
  jobType          String           @default("full_time") @map("job_type")
  location         String?
  remote           Boolean          @default(false)
  experience       String?
  salaryMin        Int?             @map("salary_min")
  salaryMax        Int?             @map("salary_max")
  showSalary       Boolean          @default(false) @map("show_salary")
  vacancies        Int              @default(1)
  description      String
  responsibilities String?
  requirements     String?
  benefits         String?
  deadline         DateTime?
  /// open, closed, draft
  status           String           @default("draft")
  views            Int              @default(0)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  applications     JobApplication[]

  @@index([status, createdAt])
  @@map("job_posts")
}

/// The CV is a private file (MEDIA_DIR/private/cv), only opened by staff through the admin API.
model JobApplication {
  id          String   @id @default(cuid())
  jobId       Int      @map("job_id")
  name        String
  email       String
  phone       String?
  coverLetter String?  @map("cover_letter")
  cvFile      String?  @map("cv_file")
  /// new, shortlisted, rejected, hired
  status      String   @default("new")
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")
  job         JobPost  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("job_applications")
}

// ───────────── Billing ─────────────

/// A bill for a plan. Prices include 13% VAT (shown on the invoice). Paid in one go by eSewa, Khalti, Fonepay
/// or a bank transfer that Sheetal confirms; paying applies the plan for the months bought.
model Invoice {
  id          String    @id @default(cuid())
  /// INV-2026-0001
  seq         Int       @unique @default(autoincrement())
  tenantId    String    @map("tenant_id")
  planId      String    @map("plan_id")
  months      Int
  /// Rs., whole rupees: subtotal + vat = total.
  subtotal    Int
  vat         Int
  total       Int
  /// open, paid, void
  status      String    @default("open")
  /// The business's name and PAN as they were when billed.
  billedTo    Json      @default("{}") @map("billed_to")
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")
  dueAt       DateTime  @map("due_at")
  paidAt      DateTime? @map("paid_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  payments    Payment[]

  @@index([tenantId, createdAt])
  @@index([status, dueAt])
  @@map("invoices")
}

model Payment {
  id          String    @id @default(cuid())
  invoiceId   String    @map("invoice_id")
  tenantId    String    @map("tenant_id")
  /// esewa, khalti, fonepay, manual
  provider    String
  amount      Int
  /// initiated, pending_review (manual proof sent), paid, failed, refunded
  status      String    @default("initiated")
  /// Our id sent to the gateway (unique per attempt).
  ref         String    @unique
  /// The gateway's id for the payment (eSewa ref, Khalti pidx, Fonepay UID).
  providerRef String?   @map("provider_ref")
  /// Bank transfer proof (a private file).
  proofFile   String?   @map("proof_file")
  note        String?
  /// What the gateway answered, for checking later (no card or account numbers are ever sent to us).
  raw         Json?
  userId      String?   @map("user_id")
  reviewedBy  String?   @map("reviewed_by")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

// ───────────── Hotels and stays ─────────────

/// A room (or a whole unit for a host). `status` is the front desk's view: vacant, arriving, occupied, dirty, blocked.
model Room {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  /// The stay listing it belongs to, when there is one.
  listingId Int?      @map("listing_id")
  branchId  String?   @map("branch_id")
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  no        String
  type      String
  /// Rs. a night.
  rate      Int
  maxGuests Int       @default(2) @map("max_guests")
  floor     String?
  status    String    @default("vacant")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  bookings  Booking[]

  @@unique([tenantId, no])
  @@index([tenantId, type])
  @@index([branchId])
  @@map("rooms")
}

/// A stay: requested (from the website or another site), confirmed, checked_in, completed, or cancelled.
model Booking {
  id          String         @id @default(cuid())
  /// BK-0001
  seq         Int            @unique @default(autoincrement())
  tenantId    String         @map("tenant_id")
  roomId      String?        @map("room_id")
  branchId    String?        @map("branch_id")
  branch      Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roomType    String         @map("room_type")
  guestName   String         @map("guest_name")
  phone       String?
  email       String?
  adults      Int            @default(2)
  children    Int            @default(0)
  /// Dates only (check-in day and check-out day, midnight UTC).
  checkIn     DateTime       @map("check_in")
  checkOut    DateTime       @map("check_out")
  /// Rs. a night agreed for this stay.
  rate        Int
  status      String         @default("confirmed")
  /// shetal, direct, walkin, booking, airbnb, agoda, expedia
  source      String         @default("direct")
  /// The guest ID was seen at check-in (Nepal requires it).
  idChecked   Boolean        @default(false) @map("id_checked")
  notes       String?
  /// The other site's id for a stay imported from its calendar (iCal UID), so syncing again updates it.
  externalUid String?        @map("external_uid")
  createdBy   String?        @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  checkedIn   DateTime?      @map("checked_in_at")
  checkedOut  DateTime?      @map("checked_out_at")
  room        Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  folio       FolioLine[]
  payments    GuestPayment[]

  @@unique([tenantId, externalUid])
  @@index([tenantId, status, checkIn])
  @@index([roomId, checkIn])
  @@index([branchId])
  @@map("bookings")
}

/// What a guest is charged during a stay: room nights, restaurant bills put on the room, extras, discounts (negative).
model FolioLine {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  /// room, pos, extra, discount
  kind      String
  what      String
  qty       Int      @default(1)
  /// Rs. before service charge and VAT.
  amount    Int
  byUserId  String?  @map("by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("folio_lines")
}

model GuestPayment {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  /// cash, fonepay, card, esewa, khalti, bank
  method    String
  amount    Int
  ref       String?
  byUserId  String?  @map("by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("guest_payments")
}

// ───────────── Point of sale ─────────────

model MenuItem {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  /// null = on the menu at every branch.
  branchId  String?  @map("branch_id")
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  outlet    String   @default("Restaurant")
  category  String   @default("Food")
  name      String
  price     Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, outlet])
  @@map("menu_items")
}

/// A cashier shift: opened with a cash float, closed with the cash counted against what was sold in cash.
model Shift {
  id       String    @id @default(cuid())
  tenantId String    @map("tenant_id")
  branchId String?   @map("branch_id")
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  openedBy String    @map("opened_by")
  float    Int       @default(0)
  openedAt DateTime  @default(now()) @map("opened_at")
  closedBy String?   @map("closed_by")
  closedAt DateTime? @map("closed_at")
  /// Cash counted at close, and the difference from expected.
  counted  Int?
  diff     Int?
  bills    PosBill[]

  @@index([tenantId, closedAt])
  @@index([branchId])
  @@map("shifts")
}

/// A restaurant or shop bill, paid on the spot or put on a guest room (then it is on their folio).
model PosBill {
  id        String   @id @default(cuid())
  seq       Int      @unique @default(autoincrement())
  tenantId  String   @map("tenant_id")
  branchId  String?  @map("branch_id")
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shiftId   String?  @map("shift_id")
  outlet    String
  /// [{ itemId?, name, qty, price }]
  lines     Json
  subtotal  Int
  discount  Int      @default(0)
  service   Int
  vat       Int
  total     Int
  /// cash, fonepay, card, esewa, khalti, room
  method    String
  bookingId String?  @map("booking_id")
  /// paid, void
  status    String   @default("paid")
  voidNote  String?  @map("void_note")
  byUserId  String?  @map("by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  shift     Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([branchId])
  @@map("pos_bills")
}

// ───────────── Developer projects ─────────────

/// A unit in a project (a flat, a plot, a shop): available, held (a few days), reserved, sold.
model Unit {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  /// The project listing.
  listingId    Int           @map("listing_id")
  block        String        @default("")
  no           String
  type         String
  sizeSqft     Int?          @map("size_sqft")
  price        BigInt
  status       String        @default("available")
  holdUntil    DateTime?     @map("hold_until")
  createdAt    DateTime      @default(now()) @map("created_at")
  reservations Reservation[]

  @@unique([listingId, block, no])
  @@index([tenantId, status])
  @@map("units")
}

/// A buyer reservation of a unit, with its payment plan (instalments) and what has been collected.
model Reservation {
  id          String       @id @default(cuid())
  seq         Int          @unique @default(autoincrement())
  tenantId    String       @map("tenant_id")
  unitId      String       @map("unit_id")
  buyerName   String       @map("buyer_name")
  phone       String?
  email       String?
  price       BigInt
  /// reserved, sold, cancelled
  status      String       @default("reserved")
  /// [{ label, due (YYYY-MM-DD), amount }]
  plan        Json         @default("[]")
  notes       String?
  createdBy   String?      @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  collections Collection[]

  @@index([tenantId, status])
  @@map("reservations")
}

/// Money received on a reservation. A refund is a negative amount.
model Collection {
  id            String      @id @default(cuid())
  reservationId String      @map("reservation_id")
  tenantId      String      @map("tenant_id")
  amount        BigInt
  method        String
  ref           String?
  note          String?
  byUserId      String?     @map("by_user_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("collections")
}

// ───────────── Investments (sponsors) ─────────────

/// An investor commitment to an investment listing: pledged, then paid (or refunded).
model Commitment {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  listingId Int       @map("listing_id")
  name      String
  email     String?
  phone     String?
  amount    BigInt
  /// pledged, paid, refunded
  status    String    @default("pledged")
  paidAt    DateTime? @map("paid_at")
  ref       String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId, listingId])
  @@map("commitments")
}

/// News for the investors in one investment, emailed to everyone who committed.
model InvestmentUpdate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  listingId Int      @map("listing_id")
  title     String
  body      String
  byUserId  String?  @map("by_user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([listingId, createdAt])
  @@map("investment_updates")
}

// ───────────── AI and analytics ─────────────

/// One AI request, for monthly credits per business (1 credit per 1,000 tokens, at least 1) and cost tracking.
model AiUsage {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id")
  userId    String?  @map("user_id")
  /// compare, extract_leads
  feature   String
  model     String
  inputTok  Int      @map("input_tokens")
  outputTok Int      @map("output_tokens")
  credits   Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("ai_usage")
}

/// A page seen on the website by a person (bots are never stored). The session id is the browser's random id, hashed.
model PageView {
  id        String   @id @default(cuid())
  session   String
  path      String
  pageType  String?  @map("page_type")
  listingId Int?     @map("listing_id")
  tenantId  String?  @map("tenant_id")
  referrer  String?
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([listingId, createdAt])
  @@index([tenantId, createdAt])
  @@map("page_views")
}

/// Visits that were filtered out as bots, counted per day and kind (search engine, other bot).
model BotDay {
  day   String
  kind  String
  count Int    @default(0)

  @@id([day, kind])
  @@map("bot_days")
}

// ───────────── Channels and other sites ─────────────

/// A business's WhatsApp number or Facebook page connected to its Inbox. The access token is encrypted.
model ChannelAccount {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  /// whatsapp, messenger, instagram
  kind        String
  /// WhatsApp phone number id, or the Facebook page id.
  externalId  String   @unique @map("external_id")
  name        String
  accessToken String   @map("access_token")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("channel_accounts")
}

/// A calendar feed (iCal) from Booking.com, Airbnb, Agoda… for one room type: its stays block those rooms here.
model OtaFeed {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  roomType  String    @map("room_type")
  /// booking, airbnb, agoda, expedia, other
  site      String
  url       String
  lastSync  DateTime? @map("last_sync")
  lastError String?   @map("last_error")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("ota_feeds")
}
