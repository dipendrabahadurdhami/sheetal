  @@index([tenantId, createdAt])
  @@index([branchId])
  @@map("pos_bills")
}

// ───────────── Developer projects ─────────────

/// A unit in a project (a flat, a plot, a shop): available, held (a few days), reserved, sold.
/// @app projects
model Unit {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  /// The project listing.
  listingId    Int           @map("listing_id")
  block        String        @default("")
  no           String
  type         String
  sizeSqft     Int?          @map("size_sqft")
  price        BigInt
  status       String        @default("available")
  holdUntil    DateTime?     @map("hold_until")
  createdAt    DateTime      @default(now()) @map("created_at")
