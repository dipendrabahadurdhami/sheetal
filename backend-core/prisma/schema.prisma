// Sheetal Property database. Models are added module by module (see docs/backend-plan.md phases).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Platform-wide settings (site name, VAT, trial days…), one row per key.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ───────────── Accounts ─────────────

enum UserStatus {
  active
  suspended
}

model User {
  id              String     @id @default(cuid())
  /// Always stored lower-case.
  email           String     @unique
  userName        String     @map("user_name")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  phone           String?
  address         String?
  photoUrl        String?    @map("photo_url")
  /// What the person said they are when signing up (buyer, owner, agent…); shown, not used for access.
  userType        String     @default("user") @map("user_type")
  /// Null for accounts imported from the old site until the person sets a new password.
  passwordHash    String?    @map("password_hash")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  status          UserStatus @default(active)
  /// Sheetal staff role (super_admin, operations, finance, content_editor, support); null for everyone else.
  platformRole    String?    @map("platform_role")
  /// Old site's users.id and role, kept for the import and for clarity.
  legacyId        Int?       @unique @map("legacy_id")
  legacyRole      String?    @map("legacy_role")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  sessions    Session[]
  tokens      EmailToken[]
  memberships Membership[]

  @@map("users")
}

/// A logged-in device. The browser holds a random token; only its SHA-256 hash is stored.
model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum TokenPurpose {
  verify_email
  reset_password
}

/// One-time links sent by email (verify address, reset password). Only the hash is stored.
model EmailToken {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

// ───────────── Businesses, plans, roles ─────────────

/// Starter (free) / Business / Pro for each business type. `limits` and `features` follow shared/src/core/plans.js.
model Plan {
  id       String   @id
  type     String
  name     String
  /// Rs. per month; longer periods get the PERIODS discount.
  price    Int
  limits   Json
  features Json
  active   Boolean  @default(true)
  sort     Int      @default(0)
  tenants  Tenant[]

  @@map("plans")
}

enum TenantStatus {
  trial
  active
  past_due
  suspended
  cancelled
  pending_verification
}

/// A business workspace (agency, hotel, host, developer, sponsor).
model Tenant {
  id            String       @id @default(cuid())
  name          String
  type          String
  city          String?
  email         String?
  phone         String?
  pan           String?
  /// Logo shown on the website and receipts (a website path or a photo address).
  logoUrl       String?      @map("logo_url")
  planId        String       @map("plan_id")
  plan          Plan         @relation(fields: [planId], references: [id])
  status        TenantStatus @default(active)
  /// Months paid for (1, 3, 6 or 12).
  period        Int          @default(1)
  renewsAt      DateTime?    @map("renews_at")
  /// Only a super admin can switch this on.
  autoRenew     Boolean      @default(false) @map("auto_renew")
  emailVerified Boolean      @default(false) @map("email_verified")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  roles       Role[]
  memberships Membership[]
  invites     Invite[]

  @@index([type])
  @@map("tenants")
}

/// A role inside one business: a named set of permission ids (see src/domain/permissions.ts).
model Role {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  key         String
  name        String?
  system      Boolean      @default(true)
  perms       String[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, key])
  @@map("roles")
}

/// A person in a business, with one role. `scopes` = "all" or a list of branches.
model Membership {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  roleId    String   @map("role_id")
  scopes    Json     @default("\"all\"")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

// ───────────── Email outbox and audit ─────────────

/// Every email the platform sends, queued here first; the mail sender (Cloudflare setup) delivers them.
model OutboundEmail {
  id        String    @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String?
  status    String    @default("queued")
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")

  @@index([status, createdAt])
  @@map("outbound_emails")
}

/// Who did what, for the admin audit log and business activity.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  tenantId  String?  @map("tenant_id")
  action    String
  target    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ───────────── Listings (properties for sale and rent) ─────────────

enum ListingPurpose {
  sale
  rent
}

/// draft → pending (Sheetal checks it) → published, or rejected with a note. A business can pause or archive its own
/// listings; removed ones are kept only so leads and history still point somewhere.
enum ListingStatus {
  draft
  pending
  published
  sold
  rented
  expired
  removed
  paused
  rejected
  archived
}

/// One table for every property, posted from /business and shown on the website.
/// Public fields are columns; `details` holds the rest of what visitors may see; `private` never leaves the server.
model Listing {
  id            Int            @id @default(autoincrement())
  /// Shown to people and used in links: SP-0006.
  code          String         @unique
  slug          String         @unique
  tenantId      String?        @map("tenant_id")
  /// The person who posted it (imported listings keep their old poster).
  userId        String?        @map("user_id")
  /// What is offered, as in /business: sell, rentout, stay_hotel, stay_unit, project, invest
  /// (shared/src/data/catalog.js listingKinds). `purpose` says whether the deal is a sale or a rent.
  kind          String         @default("sell")
  purpose       ListingPurpose
  /// House, Land, Apartment, Office space… (see catalog in shared/src/data/catalog.js).
  category      String
  propertyType  String?        @map("property_type")
  title         String
  /// Sanitised HTML.
  description   String?
  highlights    String?
  status        ListingStatus  @default(draft)
  /// Rs. Total price for sale; monthly rent for rent.
  price         BigInt?
  pricePer      String?        @map("price_per")
  negotiable    Boolean        @default(false)
  province      String?
  district      String?
  city          String?
  /// Neighbourhood (tol) as people say it: "Dhapasi, Tillingtar".
  area          String?
  street        String?
  ward          String?
  /// Exact point. Sale and rent listings are only ever sent as an approximate area (see website/backend geo).
  lat           Float?
  lng           Float?
  bedrooms      Int?
  bathrooms     Int?
  kitchens      Int?
  livingRooms   Int?           @map("living_rooms")
  floors        Float?
  parking       String?
  /// As written by the owner ("3 Aana 1 Paisa"); `landSqft` is the same size in sq ft for filters.
  landArea      String?        @map("land_area")
  landSqft      Float?         @map("land_sqft")
  builtArea     String?        @map("built_area")
  roadAccess    String?        @map("road_access")
  roadType      String?        @map("road_type")
  facing        String?
  builtYear     String?        @map("built_year")
  furnishing    String?
  facilities    String[]       @default([])
  youtubeUrl    String?        @map("youtube_url")
  details       Json           @default("{}")
  /// Owner name and phone, lalpurja number, commission, internal notes. Never sent to the website.
  private       Json           @default("{}")
  featured      Boolean        @default(false)
  featuredOrder Int            @default(0) @map("featured_order")
  views         Int            @default(0)
  /// Fixes proposed from the title and description (import or AI) for a person to accept.
  suggest       Json?
  /// Check-ups: the next date someone should confirm it is still correct (listings never expire on their own).
  checkDueAt    DateTime?      @map("check_due_at")
  lastCheckedAt DateTime?      @map("last_checked_at")
  lastCheckedBy String?        @map("last_checked_by")
  /// Sheetal's review: when it was sent for review, who decided, and the note sent back when changes are needed.
  submittedAt   DateTime?      @map("submitted_at")
  reviewedAt    DateTime?      @map("reviewed_at")
  reviewedBy    String?        @map("reviewed_by")
  reviewNote    String?        @map("review_note")
  legacyId      Int?           @unique @map("legacy_id")
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  photos        ListingPhoto[]

  @@index([status, kind, publishedAt])
  @@index([status, purpose, publishedAt])
  @@index([status, featured, featuredOrder])
  @@index([district])
  @@index([category])
  @@index([tenantId, status])
  @@index([userId])
  @@index([status, submittedAt])
  @@map("listings")
}

/// Photos in display order; `file` is the name inside the media store (main, thumbnail and original sizes share it).
model ListingPhoto {
  id        Int     @id @default(autoincrement())
  listingId Int     @map("listing_id")
  file      String
  sort      Int     @default(0)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sort])
  @@map("listing_photos")
}

// ───────────── Business email (own domains, own mail server) ─────────────
// A business connects its domain, proves it with DNS records, then gives each team member a mailbox.
// Paid plans only; storage is counted per business (all mailboxes together).

/// A business's own domain for email. Mailboxes can be created only once it is verified.
model MailDomain {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  /// Always lower-case, e.g. "everestinn.com".
  name           String    @unique
  verified       Boolean   @default(false)
  /// Proof the business owns the domain (a TXT record).
  verifyToken    String    @map("verify_token")
  dkimSelector   String    @default("sheetal") @map("dkim_selector")
  dkimPublicKey  String    @map("dkim_public_key")
  /// Encrypted with SECRETS_KEY (backend-core/src/lib/vault.ts).
  dkimPrivateKey String    @map("dkim_private_key")
  /// Last DNS check: record id → "ok" | "missing" | "wrong".
  checks         Json      @default("{}")
  checkedAt      DateTime? @map("checked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  mailboxes      Mailbox[]

  @@index([tenantId])
  @@map("mail_domains")
}

/// An address on a business domain: one person's mailbox, or a shared one (info@, sales@) several people answer.
model Mailbox {
  id        String          @id @default(cuid())
  tenantId  String          @map("tenant_id")
  domainId  String          @map("domain_id")
  /// Full address, lower-case: "ram@everestinn.com".
  address   String          @unique
  name      String
  /// "person" or "shared".
  kind      String          @default("person")
  /// The team member a personal mailbox belongs to.
  userId    String?         @map("user_id")
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")
  domain    MailDomain      @relation(fields: [domainId], references: [id], onDelete: Cascade)
  access    MailboxAccess[]
  messages  MailMessage[]

  @@index([tenantId])
  @@index([userId])
  @@map("mailboxes")
}

/// Who else may use a mailbox (the people who answer a shared address).
model MailboxAccess {
  mailboxId String  @map("mailbox_id")
  userId    String  @map("user_id")
  mailbox   Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@id([mailboxId, userId])
  @@index([userId])
  @@map("mailbox_access")
}

/// One email in one mailbox. A message sent to a teammate is stored twice: in the sender's Sent and the teammate's Inbox.
model MailMessage {
  id          String           @id @default(cuid())
  mailboxId   String           @map("mailbox_id")
  tenantId    String           @map("tenant_id")
  /// inbox, sent, drafts, archive, spam, trash
  folder      String
  /// Replies share the thread of the message they answer.
  threadId    String           @map("thread_id")
  /// The internet Message-ID header, for replies across servers.
  messageId   String           @map("message_id")
  inReplyTo   String?          @map("in_reply_to")
  fromAddress String           @map("from_address")
  fromName    String?          @map("from_name")
  to          String[]         @default([])
  cc          String[]         @default([])
  bcc         String[]         @default([])
  subject     String           @default("")
  text        String           @default("")
  /// Sanitised HTML, when the mail has it.
  html        String?
  snippet     String           @default("")
  /// Bytes counted against the business's storage (body plus attachments).
  size        Int              @default(0)
  seen        Boolean          @default(false)
  starred     Boolean          @default(false)
  /// received, draft, delivered (to a teammate), queued (for the mail server), sent, failed
  status      String
  error       String?
  sentAt      DateTime?        @map("sent_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  mailbox     Mailbox          @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  attachments MailAttachment[]
  deliveries  MailDelivery[]

  @@index([mailboxId, folder, createdAt])
  @@index([tenantId])
  @@index([threadId])
  @@index([status])
  @@map("mail_messages")
}

model MailAttachment {
  id          String      @id @default(cuid())
  messageId   String      @map("message_id")
  filename    String
  contentType String      @map("content_type")
  size        Int
  /// Kept in the database for now; moves to object storage with photos later.
  data        Bytes
  message     MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("mail_attachments")
}

/// One outside recipient of a sent email, worked through by the mail server: queued → sending → sent,
/// or deferred (temporary problem, tried again later) → failed after the last attempt or a permanent refusal.
model MailDelivery {
  id            String      @id @default(cuid())
  messageId     String      @map("message_id")
  tenantId      String      @map("tenant_id")
  recipient     String
  status        String      @default("queued")
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at")
  /// Set while a mail server works on it, so two servers never send the same mail.
  lockedUntil   DateTime?   @map("locked_until")
  lastError     String?     @map("last_error")
  /// The receiving server's last reply, e.g. "250 2.0.0 OK".
  response      String?
  sentAt        DateTime?   @map("sent_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  message       MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([messageId])
  @@map("mail_deliveries")
}

// ───────────── Website: favourites, enquiries, reviews, upgrades ─────────────

/// A listing someone saved.
model Favourite {
  userId    String   @map("user_id")
  listingId Int      @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, listingId])
  @@index([listingId])
  @@map("favourites")
}

/// An enquiry from the website: contact the agency or owner, a site visit, a buyer requirement, a service request.
/// It goes to the business that owns the listing (or to Sheetal when there is none) and shows in its Inbox.
model Lead {
  id         String        @id @default(cuid())
  /// The business it is for; null = Sheetal itself.
  tenantId   String?       @map("tenant_id")
  listingId  Int?          @map("listing_id")
  userId     String?       @map("user_id")
  /// contact_agent, contact_owner, site_visit, requirement, service
  kind       String
  name       String
  email      String?
  phone      String?
  message    String        @default("")
  /// Everything else the form sent (reasons, budget, preferred time…).
  details    Json          @default("{}")
  /// Pipeline stage: new, contacted, viewing, negotiating, won, lost
  status     String        @default("new")
  /// The team member following it up (a user id), the next follow-up date, tags and the deal value in Rs.
  assigneeId String?       @map("assignee_id")
  followAt   DateTime?     @map("follow_at")
  tags       String[]      @default([])
  value      BigInt?
  /// When the business last opened it; newer messages count as unread.
  readAt     DateTime?     @map("read_at")
  /// Buyer requirements: shown on the website's requirement board (never with contact details) once any fee is confirmed.
  public     Boolean       @default(false)
  /// Requirement fee: pending (proof sent), confirmed or rejected by Sheetal; the amount in Rs., the payment
  /// reference and the proof image (a private file, never served publicly).
  feeStatus  String?       @map("fee_status")
  feeAmount  Int?          @map("fee_amount")
  feeRef     String?       @map("fee_ref")
  feeProof   String?       @map("fee_proof")
  legacyId   Int?          @unique @map("legacy_id")
  /// Short public number: REQ-0042 on the requirement board.
  ref        Int           @unique @default(autoincrement())
  lastAt     DateTime      @default(now()) @map("last_at")
  ip         String?
  createdAt  DateTime      @default(now()) @map("created_at")
  messages   LeadMessage[]
  matches    DemandMatch[]

  @@index([kind, public, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, lastAt])
  @@index([listingId])
  @@map("leads")
}

/// Replies on a lead: "in" from the person (the first message is the lead itself), "out" from the business (sent by email).
model LeadMessage {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  direction String
  body      String
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_messages")
}

/// A star rating with a comment, for a listing or for a business. One per person per listing or business.
model Review {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  listingId Int?     @map("listing_id")
  tenantId  String?  @map("tenant_id")
  rating    Int
  comment   String   @default("")
  /// published or hidden (by the business or Sheetal)
  status    String   @default("published")
  /// The business's public answer.
  reply     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, listingId])
  @@unique([userId, tenantId])
  @@index([listingId, status])
  @@index([tenantId, status])
  @@map("reviews")
}

/// A business asking to move to a paid plan; Sheetal's team follows up and takes payment.
model UpgradeRequest {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  planId    String   @map("plan_id")
  months    Int
  /// pending, done, declined
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("upgrade_requests")
}

/// An invitation to join a business's team, sent by email. Only the hash of the link's token is stored.
model Invite {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  /// Lower-case.
  email     String
  roleId    String   @map("role_id")
  scopes    Json     @default("\"all\"")
  tokenHash String   @unique @map("token_hash")
  invitedBy String?  @map("invited_by")
  /// pending, accepted, revoked
  status    String   @default("pending")
  expiresAt DateTime @map("expires_at")
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([email])
  @@map("invites")
}

// ───────────── Requirement board, notifications ─────────────

/// An agent or owner offering one of their listings for a buyer's requirement. The buyer is told by email and notification.
model DemandMatch {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  listingId Int      @map("listing_id")
  userId    String   @map("user_id")
  message   String   @default("")
  /// sent, seen, interested, declined
  status    String   @default("sent")
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, listingId])
  @@index([userId])
  @@map("demand_matches")
}

/// Something a person should know: listing approved, new offer on their requirement, new enquiry…
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  message   String    @default("")
  /// Where it leads in the website or a panel, e.g. /property/… or /business/inbox.
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}

// ───────────── Blog and careers ─────────────

model BlogCategory {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  active      Boolean    @default(true)
  legacyId    Int?       @unique @map("legacy_id")
  posts       BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id              Int           @id @default(autoincrement())
  categoryId      Int?          @map("category_id")
  authorId        String?       @map("author_id")
  title           String
  slug            String        @unique
  /// Sanitised HTML.
  content         String
  excerpt         String?
  /// A file in MEDIA_DIR/blog, or a full URL.
  image           String?
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description")
  tags            String[]      @default([])
  /// draft, published
  status          String        @default("draft")
  allowComments   Boolean       @default(true) @map("allow_comments")
  publishedAt     DateTime?     @map("published_at")
  views           Int           @default(0)
  legacyId        Int?          @unique @map("legacy_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments        BlogComment[]

  @@index([status, publishedAt])
  @@map("blog_posts")
}

/// Comments wait for Sheetal to approve them before they show.
model BlogComment {
  id        String   @id @default(cuid())
  postId    Int      @map("post_id")
  userId    String?  @map("user_id")
  name      String
  email     String?
  comment   String
  /// pending, approved, rejected
  status    String   @default("pending")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, status])
  @@index([status, createdAt])
  @@map("blog_comments")
}

model JobPost {
  id               Int              @id @default(autoincrement())
  title            String
  slug             String           @unique
  department       String?
  /// full_time, part_time, contract, internship
  jobType          String           @default("full_time") @map("job_type")
  location         String?
  remote           Boolean          @default(false)
  experience       String?
  salaryMin        Int?             @map("salary_min")
  salaryMax        Int?             @map("salary_max")
  showSalary       Boolean          @default(false) @map("show_salary")
  vacancies        Int              @default(1)
  description      String
  responsibilities String?
  requirements     String?
  benefits         String?
  deadline         DateTime?
  /// open, closed, draft
  status           String           @default("draft")
  views            Int              @default(0)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  applications     JobApplication[]

  @@index([status, createdAt])
  @@map("job_posts")
}

/// The CV is a private file (MEDIA_DIR/private/cv), only opened by staff through the admin API.
model JobApplication {
  id          String   @id @default(cuid())
  jobId       Int      @map("job_id")
  name        String
  email       String
  phone       String?
  coverLetter String?  @map("cover_letter")
  cvFile      String?  @map("cv_file")
  /// new, shortlisted, rejected, hired
  status      String   @default("new")
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")
  job         JobPost  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("job_applications")
}
