// ───────────── Billing ─────────────

/// A bill for a plan. Prices include 13% VAT (shown on the invoice). Paid in one go by eSewa, Khalti, Fonepay
/// or a bank transfer that Sheetal confirms; paying applies the plan for the months bought.
/// @app platform
model Invoice {
  id          String    @id @default(cuid())
  /// INV-2026-0001
  seq         Int       @unique @default(autoincrement())
  tenantId    String    @map("tenant_id")
  planId      String    @map("plan_id")
  months      Int
  /// Rs., whole rupees: subtotal + vat = total.
  subtotal    Int
  vat         Int
  total       Int
  /// open, paid, void
  status      String    @default("open")
  /// The business's name and PAN as they were when billed.
  billedTo    Json      @default("{}") @map("billed_to")
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")
  /// plan (a plan period, with the add-ons that renew with it), addon (add-ons bought for the rest of the period) or
  /// boost (paid boosts on the website, domain/promote.ts) or banner (home page banners, domain/banners.ts)
  kind        String    @default("plan")
  /// Add-on lines: [{ id, name, qty, price, months }] (price a month per unit, VAT included).
  addons      Json      @default("[]")
  dueAt       DateTime  @map("due_at")
  paidAt      DateTime? @map("paid_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  payments    Payment[]

  @@index([tenantId, createdAt])
  @@index([status, dueAt])
  @@map("invoices")
}

/// @app platform
model Payment {
  id          String    @id @default(cuid())
  invoiceId   String    @map("invoice_id")
  tenantId    String    @map("tenant_id")
  /// esewa, khalti, fonepay, manual
  provider    String
  amount      Int
  /// initiated, pending_review (manual proof sent), paid, failed, refunded
  status      String    @default("initiated")
  /// Our id sent to the gateway (unique per attempt).
  ref         String    @unique
  /// The gateway's id for the payment (eSewa ref, Khalti pidx, Fonepay UID).
  providerRef String?   @map("provider_ref")
  /// Bank transfer proof (a private file).
  proofFile   String?   @map("proof_file")
  note        String?
  /// What the gateway answered, for checking later (no card or account numbers are ever sent to us).
  raw         Json?
  userId      String?   @map("user_id")
  reviewedBy  String?   @map("reviewed_by")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

// ───────────── Hotels and stays ─────────────

/// One night's price or closing for a room type at a branch (the calendar). No row = the normal price, open.
/// @app hotel
model RateDay {
  id       String   @id @default(cuid())
  tenantId String   @map("tenant_id")
  branchId String   @map("branch_id")
  roomType String   @map("room_type")
  /// The night (date only, midnight UTC), as booking check-in days.
  day      DateTime
  /// Rs. for that night; null = the normal price (with the weekend rule).
  rate     Int?
  /// Closed to new bookings that night.
  closed   Boolean  @default(false)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, roomType, day])
  @@index([tenantId, branchId, roomType, day])
  @@map("rate_days")
}

/// Pricing rules of a room type at a branch: a weekend markup (Friday and Saturday nights) and the shortest stay.
/// @app hotel
model RoomRule {
  id         String @id @default(cuid())
  tenantId   String @map("tenant_id")
  branchId   String @map("branch_id")
  roomType   String @map("room_type")
  weekendPct Int    @default(0) @map("weekend_pct")
  minNights  Int    @default(1) @map("min_nights")
  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, roomType])
  @@map("room_rules")
}

/// A room (or a whole unit for a host). `status` is the front desk's view: vacant, arriving, occupied, dirty, blocked.
/// @app hotel
model Room {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  /// The stay listing it belongs to, when there is one.
  listingId Int?      @map("listing_id")
  branchId  String?   @map("branch_id")
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  no        String
  type      String
  /// Rs. a night.
  rate      Int
  maxGuests Int       @default(2) @map("max_guests")
  floor     String?
  status    String    @default("vacant")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  bookings  Booking[]

  @@unique([tenantId, no])
  @@index([tenantId, type])
  @@index([branchId])
  @@map("rooms")
}

/// A stay: requested (from the website or another site), confirmed, checked_in, completed, or cancelled.
/// @app hotel
model Booking {
  id          String         @id @default(cuid())
  /// BK-0001
  seq         Int            @unique @default(autoincrement())
  tenantId    String         @map("tenant_id")
  roomId      String?        @map("room_id")
  branchId    String?        @map("branch_id")
  branch      Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roomType    String         @map("room_type")
  guestName   String         @map("guest_name")
  phone       String?
  email       String?
  adults      Int            @default(2)
  children    Int            @default(0)
  /// Dates only (check-in day and check-out day, midnight UTC).
  checkIn     DateTime       @map("check_in")
  checkOut    DateTime       @map("check_out")
  /// Rs. a night agreed for this stay.
  rate        Int
  status      String         @default("confirmed")
  /// shetal, direct, walkin, booking, airbnb, agoda, expedia
  source      String         @default("direct")
  /// The guest ID was seen at check-in (Nepal requires it).
  idChecked   Boolean        @default(false) @map("id_checked")
  notes       String?
  /// The other site's id for a stay imported from its calendar (iCal UID), so syncing again updates it.
  externalUid String?        @map("external_uid")
  createdBy   String?        @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  checkedIn   DateTime?      @map("checked_in_at")
  checkedOut  DateTime?      @map("checked_out_at")
  room        Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  folio       FolioLine[]
  payments    GuestPayment[]

  @@unique([tenantId, externalUid])
  @@index([tenantId, status, checkIn])
  @@index([roomId, checkIn])
  @@index([branchId])
  @@map("bookings")
}

/// What a guest is charged during a stay: room nights, restaurant bills put on the room, extras, discounts (negative).
/// @app hotel
model FolioLine {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  /// room, pos, extra, discount
  kind      String
  what      String
  qty       Int      @default(1)
  /// Rs. before service charge and VAT.
  amount    Int
  byUserId  String?  @map("by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("folio_lines")
}

/// @app hotel
model GuestPayment {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  /// cash, fonepay, card, esewa, khalti, bank
  method    String
  amount    Int
  ref       String?
  byUserId  String?  @map("by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("guest_payments")
}

// ───────────── Point of sale ─────────────

/// @app pos
