{
  "name": "@sheetal/backend-core",
  "private": true,
  "version": "0.1.0",
  "description": "Shared by the website, business and admin APIs: database schema, errors, cache, login sessions, health",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "photos:resize": "tsx scripts/resize-photos.ts",
    "listings:tidy": "tsx scripts/tidy-listings.ts",
    "payouts:sample": "tsx scripts/payouts-sample.ts",
    "reviews:sample": "tsx scripts/reviews-sample.ts",
    "integrations:migrate": "tsx scripts/integrations-migrate.ts",
    "billing:migrate": "tsx scripts/migrate-plans-to-apps.ts",
    "billing:mode": "tsx scripts/billing-mode.ts",
    "check:catalog": "tsx scripts/check-catalog.ts",
    "promote:gift": "tsx scripts/promote-gift.ts",
    "listings:codes": "tsx scripts/listing-codes.ts",
    "accounts:test": "tsx scripts/test-accounts.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "embedded-postgres": "^17.11.0-beta.19",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@sheetal/platform": "*",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7",
    "sharp": "^0.34.3",
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "exports": {
    "./*": "./src/*.ts"
  }
}
