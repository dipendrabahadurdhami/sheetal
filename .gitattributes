# Store text files with Unix line endings so diffs stay clean on every OS.
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary

# Generated files are always LF so gen:permissions --check gives the same answer on Windows (P1-BE-2).
*.generated.* text eol=lf
