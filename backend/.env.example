# Local development settings for the API. Copy to backend/.env (git-ignored).
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# From `npm run db:local` (local-only password, not used anywhere else):
DATABASE_URL=postgresql://sheetal:sheetal_local@localhost:5433/sheetal
# Leave empty locally (in-memory cache); set on the server:
REDIS_URL=
CORS_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173
API_URL=http://localhost:4000
