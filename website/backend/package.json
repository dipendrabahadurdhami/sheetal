{
  "name": "@sheetal/website-api",
  "private": true,
  "version": "0.1.0",
  "description": "Website API (port 4000): accounts and login, properties, search, map, agencies",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node ../../scripts/build-api.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "import:old": "tsx scripts/import-old-site.ts",
    "import:old-content": "tsx scripts/import-old-content.ts"
  },
  "dependencies": {
    "@sheetal/backend-core": "*",
    "fastify": "^5.12.7",
    "zod": "^4.6.7",
    "@prisma/client": "^6.19.3",
    "@sheetal/app-agreements": "*",
    "@sheetal/app-crm": "*",
    "@sheetal/platform": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
