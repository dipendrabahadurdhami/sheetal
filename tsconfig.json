{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@sheetal/shared/*": ["./shared/src/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": [
    "shared/src",
    "website/frontend/src",
    "admin/frontend/src",
    "business/frontend/src"
  ]
}