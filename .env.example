# Copy to .env and fill in. .env is never committed (see .gitignore).
# The backend reads these once to create the first accounts; change the passwords after the first login.

# ── First accounts ──
SUPER_ADMIN_EMAIL=admin@sheetalproperty.com
SUPER_ADMIN_PASSWORD=
SHEETAL_OWNER_EMAIL=shetalrealestate@gmail.com
SHEETAL_OWNER_PASSWORD=

# ── Site ──
SITE_URL=https://sheetalproperty.com
API_URL=https://api.sheetalproperty.com
VITE_SITE_URL=https://sheetalproperty.com

# ── Database and cache ──
DATABASE_URL=postgresql://sheetal:CHANGE_ME@localhost:5432/sheetal
REDIS_URL=redis://localhost:6379

# Everything else (Cloudflare, WhatsApp, Meta, Google, AI, ElevenLabs, payment keys) is entered in
# Admin → Setup center and stored encrypted in the database, not here.
SECRETS_ENCRYPTION_KEY=
