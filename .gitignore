# .gitignore: what git must never hold (secrets, local data, generated files, big files).
# Rule of thumb: if it has a password, a key or a customer's data in it, it goes here.

# ───── Packages and build output ─────
node_modules
dist
*/frontend/dist
.vite
coverage
*.log
npm-debug.log*

# ───── Secrets: settings files with passwords and keys ─────
# `.env.*` covers .env.local, .env.production and similar; the examples stay in git.
.env
.env.*
!.env.example
!.env.*.example
.env.local.api
*.pem
*.pfx
*.p12
*.key
test-accounts.csv

# ───── Local data: never commit ─────
# Database files of the local PostgreSQL
.pgdata
# Database exports and dumps (npm run backup writes outside the repo; this is a safety net)
Sheetal-Backups/
*.dump
*.sql.gz
*.bak
# Development copies of system emails (mail-server, SYSTEM_MAIL_MODE=file)
mail-outbox/

# ───── Generated reports: output of our scripts, may hold property locations or customer data ─────
# Every script that writes a report names it <something>-report.csv, so one rule covers them
# (photo-gps-report.csv, tidy-listings-report.csv and any future one).
*-report.csv
# The GPS check also writes a summary next to its report.
photo-gps-*.csv

# ───── Update packages and files moving between chats ─────
# "Claude outputs/" is the team's kit notes and zips folder; it lives on the owner's computer only.
Claude outputs/
*.zip
OUT-*/
.foundation-1-backup/

# ───── Generated on every build (npm run sitemap) ─────
website/frontend/public/sitemap.xml

# ───── Editor, system and tool leftovers ─────
.claude/
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp
